tracker:
  type: {tracker_type}
  root: "{vault_root}"

projects:
  Agent:
    path: Agent
    repo_root: "{repo_root}"

model_proxy_server:
  port: {model_proxy_port}

runtime:
  completion_host: 0.0.0.0
  completion_container_host: host.docker.internal
  default_timeout_seconds: 30
  container_volume_relabel: true
  worker_images:
    codex: "{worker_image}"
    local_llm: "{worker_image}"
  env:
    SCRIPTED_RUNTIME_SCENARIO: "{scenario}"
