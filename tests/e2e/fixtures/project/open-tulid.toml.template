[vault]
root = "{vault_root}"
projects = ["Agent"]

[projects.Agent]
tracker_path = "Agent"
repo_root = "{repo_root}"

[workflow]
path = "{workflow_path}"

[runtime]
completion_host = "0.0.0.0"
completion_container_host = "host.docker.internal"
default_timeout_seconds = 30
container_volume_relabel = true

[runtime.worker_images]
codex = "{mock_agent_image}"

[runtime.worker_args]
codex = ["{prompt_packet}"]

[runtime.env]
MOCK_AGENT_SCENARIO = "{mock_agent_scenario}"
