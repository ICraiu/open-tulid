ARG TULID_AGENT_IMAGE
FROM ${TULID_AGENT_IMAGE}
USER root
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /usr/local/bin/
COPY --from=mongo:7 /usr/bin/mongod /usr/local/bin/mongod
RUN apt-get update && apt-get install -y --no-install-recommends libcurl4 libgssapi-krb5-2 libsasl2-2 libsnappy1v5 && rm -rf /var/lib/apt/lists/*
ENV UV_PYTHON_INSTALL_DIR=/opt/tulid-python UV_PYTHON_PREFERENCE=only-managed UV_CACHE_DIR=/tmp/tulid-uv-cache
RUN uv python install 3.12 && ln -sf "$(uv python find 3.12)" /usr/local/bin/python3 && chmod -R a+rX /opt/tulid-python
